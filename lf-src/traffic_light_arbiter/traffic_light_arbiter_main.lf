target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/traffic_light_arbiter/traffic_light_arbiter.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor traffic_light_arbiter {
    input signals_in:std::shared_ptr<autoware_perception_msgs::msg::TrafficLightGroupArray>;
    output signals_out:std::shared_ptr<autoware_perception_msgs::msg::TrafficLightGroupArray>;
    state node:{= std::shared_ptr<autoware::traffic_light::TrafficLightArbiter> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + TRAFFIC_LIGHT_ARBITER_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        self->node = std::make_shared<autoware::traffic_light::TrafficLightArbiter>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::traffic_light::TrafficLightArbiter>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::traffic_light::TrafficLightArbiter>(self->node)));
    =}

    // LF input: signals_in
    reaction (signals_in) {=
        if (signals_in->is_present) {
            self->node->onPerceptionMsg(signals_in->value);
        }
    =}
}

main reactor {
    tla = new traffic_light_arbiter();
}
