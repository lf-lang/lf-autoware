/**
 * LF reactor wrapping the Autoware Core VehicleVelocityConverter.
 *
 * Subscription-driven node: converts VelocityReport to
 * TwistWithCovarianceStamped. Runs passively via ROS callbacks
 * in the spin thread.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "vehicle_velocity_converter.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor vehicle_velocity_converter {
    state node:{= std::shared_ptr<autoware::vehicle_velocity_converter::VehicleVelocityConverter> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + VEHICLE_VELOCITY_CONVERTER_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");
        try { rclcpp::init(0, NULL); } catch (...) { }

        self->node = std::make_shared<autoware::vehicle_velocity_converter::VehicleVelocityConverter>(nodeOptions);

        // Start spin thread for subscription callbacks
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::vehicle_velocity_converter::VehicleVelocityConverter>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::vehicle_velocity_converter::VehicleVelocityConverter>(self->node)));
    =}
}

main reactor {
    vvc = new vehicle_velocity_converter();
}
