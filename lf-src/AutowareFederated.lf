/**
 * Federated Autoware LF program.
 *
 * Each reactor is a separate federate (process), matching Autoware's
 * native architecture. Flat structure like lf-avp-demo.
 *
 * Data flows via ROS2 topics (spin threads). LF controls scheduling.
 */
target CCpp {
    coordination: decentralized
};

// Sensing
import crop_box_filter from "crop_box_filter/crop_box_filter_main.lf";
import imu_corrector from "imu_corrector/imu_corrector_main.lf";
import vehicle_velocity_converter from "vehicle_velocity_converter/vehicle_velocity_converter_main.lf";

// Localization
import ndt_scan_matcher from "ndt_scan_matcher/ndt_scan_matcher_main.lf";
import gyro_odometer from "gyro_odometer/gyro_odometer_main.lf";
import ekf_localizer from "ekf_localizer/ekf_localizer_main.lf";

// Map
import pointcloud_map_loader from "pointcloud_map_loader/pointcloud_map_loader_main.lf";
import lanelet2_map_loader from "lanelet2_map_loader/lanelet2_map_loader_main.lf";

// Perception
import ground_segmentation from "ground_segmentation/ground_segmentation_main.lf";
import lidar_centerpoint from "lidar_centerpoint/lidar_centerpoint_main.lf";
import euclidean_cluster from "euclidean_cluster/euclidean_cluster_main.lf";
import pointcloud_map_filter from "pointcloud_map_filter/pointcloud_map_filter_main.lf";
import detection_by_tracker from "detection_by_tracker/detection_by_tracker_main.lf";
import object_validator from "object_validator/object_validator_main.lf";
import object_filter from "object_filter/object_filter_main.lf";
import camera_lidar_fusion from "camera_lidar_fusion/camera_lidar_fusion_main.lf";
import multi_object_tracker from "multi_object_tracker/multi_object_tracker_main.lf";
import map_based_prediction from "map_based_prediction/map_based_prediction_main.lf";
import occupancy_grid_map from "occupancy_grid_map/occupancy_grid_map_main.lf";
import traffic_light_map_based_detector from "traffic_light_map_based_detector/traffic_light_map_based_detector_main.lf";
import traffic_light_classifier from "traffic_light_classifier/traffic_light_classifier_main.lf";
import traffic_light_arbiter from "traffic_light_arbiter/traffic_light_arbiter_main.lf";
import traffic_light_occlusion_predictor from "traffic_light_occlusion_predictor/traffic_light_occlusion_predictor_main.lf";
import crosswalk_traffic_light_estimator from "crosswalk_traffic_light_estimator/crosswalk_traffic_light_estimator_main.lf";

// Planning
import mission_planner from "mission_planner/mission_planner_main.lf";
import behavior_path_planner from "behavior_path_planner/behavior_path_planner_main.lf";
import behavior_velocity_planner from "behavior_velocity_planner/behavior_velocity_planner_main.lf";
import path_smoother from "path_smoother/path_smoother_main.lf";
import path_optimizer from "path_optimizer/path_optimizer_main.lf";
import motion_velocity_planner from "motion_velocity_planner/motion_velocity_planner_main.lf";
import surround_obstacle_checker from "surround_obstacle_checker/surround_obstacle_checker_main.lf";
import scenario_selector from "scenario_selector/scenario_selector_main.lf";
import velocity_smoother from "velocity_smoother/velocity_smoother_main.lf";
import freespace_planner from "freespace_planner/freespace_planner_main.lf";
import costmap_generator from "costmap_generator/costmap_generator_main.lf";
import planning_validator from "planning_validator/planning_validator_main.lf";
import external_velocity_limit_selector from "external_velocity_limit_selector/external_velocity_limit_selector_main.lf";

// Control
import trajectory_follower from "trajectory_follower/trajectory_follower_main.lf";
import shift_decider from "shift_decider/shift_decider_main.lf";
import vehicle_cmd_gate from "vehicle_cmd_gate/vehicle_cmd_gate_main.lf";
import operation_mode_transition_manager from "operation_mode_transition_manager/operation_mode_transition_manager_main.lf";
import lane_departure_checker from "lane_departure_checker/lane_departure_checker_main.lf";
import control_validator from "control_validator/control_validator_main.lf";
import autonomous_emergency_braking from "autonomous_emergency_braking/autonomous_emergency_braking_main.lf";
import collision_detector from "collision_detector/collision_detector_main.lf";

// Bridge
import bridge_interface from "bridge_interface/bridge_interface_main.lf";

federated reactor AutowareFederated {
    // Sensing
    cbf = new crop_box_filter();
    imu = new imu_corrector();
    vvc = new vehicle_velocity_converter();

    // Localization
    ndt = new ndt_scan_matcher();
    gyro = new gyro_odometer();
    ekf = new ekf_localizer();

    // Map
    pcm = new pointcloud_map_loader();
    l2m = new lanelet2_map_loader();

    // Perception
    gs = new ground_segmentation();
    lcp = new lidar_centerpoint();
    ec = new euclidean_cluster();
    pmf = new pointcloud_map_filter();
    dbt = new detection_by_tracker();
    ov = new object_validator();
    of = new object_filter();
    clf = new camera_lidar_fusion();
    mot = new multi_object_tracker();
    mbp = new map_based_prediction();
    ogm = new occupancy_grid_map();
    tlmbd = new traffic_light_map_based_detector();
    tlc = new traffic_light_classifier();
    tla = new traffic_light_arbiter();
    tlop = new traffic_light_occlusion_predictor();
    ctle = new crosswalk_traffic_light_estimator();

    // Planning
    mp = new mission_planner();
    bpp = new behavior_path_planner();
    bvp = new behavior_velocity_planner();
    ps = new path_smoother();
    po = new path_optimizer();
    mvp = new motion_velocity_planner();
    soc = new surround_obstacle_checker();
    ss = new scenario_selector();
    vs = new velocity_smoother();
    fp = new freespace_planner();
    cg = new costmap_generator();
    pv = new planning_validator();
    evls = new external_velocity_limit_selector();

    // Control
    tf = new trajectory_follower();
    sd = new shift_decider();
    vcg = new vehicle_cmd_gate();
    omtm = new operation_mode_transition_manager();
    ldc = new lane_departure_checker();
    cv = new control_validator();
    aeb = new autonomous_emergency_braking();
    cd = new collision_detector();

    // Bridge
    bridge = new bridge_interface();

    // LF connections: Control -> BridgeInterface
    vcg.control_cmd ~> bridge.control_cmd_in serializer "ros2";
    vcg.gear_cmd ~> bridge.gear_cmd_in serializer "ros2";
    vcg.turn_indicators_cmd ~> bridge.turn_indicators_cmd_in serializer "ros2";
    vcg.hazard_lights_cmd ~> bridge.hazard_lights_cmd_in serializer "ros2";

    // LF connections: Planning internal
    ss.trajectory_out ~> vs.trajectory_in serializer "ros2";
}
