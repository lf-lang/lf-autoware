/**
 * LF reactor wrapping the Autoware Universe ScanGroundFilterComponent.
 *
 * Subscription-driven node: segments ground vs obstacle points.
 * Runs passively via ROS callbacks in the spin thread.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor ground_segmentation {
    input pointcloud_in:std::shared_ptr<sensor_msgs::msg::PointCloud2>;
    output obstacle_pointcloud_out:std::shared_ptr<sensor_msgs::msg::PointCloud2>;
    state node:{= std::shared_ptr<autoware::ground_segmentation::ScanGroundFilterComponent> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + SCAN_GROUND_FILTER_PARAM;
        std::string vehicle_info_path = home + "/" + VEHICLE_INFO_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {yaml_path, "/**"},
            {vehicle_info_path, "/**"}
        });

        self->node = std::make_shared<autoware::ground_segmentation::ScanGroundFilterComponent>(nodeOptions);

        // Start spin thread for subscription callbacks
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::ground_segmentation::ScanGroundFilterComponent>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::ground_segmentation::ScanGroundFilterComponent>(self->node)));
    =}

    // LF input: pointcloud_in (forwarded via spin thread until C++ interception added)
    reaction (pointcloud_in) {=
        // TODO: call node callback directly once C++ header is modified
        // For now, the spin thread picks up data via ROS subscription
    =}
}

main reactor {
    gs = new ground_segmentation();
}
