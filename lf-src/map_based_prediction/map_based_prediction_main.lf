/**
 * LF reactor wrapping the Autoware Universe MapBasedPredictionNode.
 *
 * Subscription-driven node: predicts object trajectories using map info.
 * Runs passively via ROS callbacks in the spin thread.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "map_based_prediction/map_based_prediction_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor map_based_prediction {
    input vector_map_in:std::shared_ptr<autoware_map_msgs::msg::LaneletMapBin>;
    // Input from multi_object_tracker
    input tracked_objects_in:std::shared_ptr<autoware_perception_msgs::msg::TrackedObjects>;
    // Output to planning nodes
    output predicted_objects_out:std::shared_ptr<autoware_perception_msgs::msg::PredictedObjects>;
    state node:{= std::shared_ptr<autoware::map_based_prediction::MapBasedPredictionNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + MAP_BASED_PREDICTION_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        self->node = std::make_shared<autoware::map_based_prediction::MapBasedPredictionNode>(nodeOptions);

        // Start spin thread for subscription callbacks
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::map_based_prediction::MapBasedPredictionNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::map_based_prediction::MapBasedPredictionNode>(self->node)));
    =}

    // LF input: tracked_objects_in
    reaction (tracked_objects_in) {=
        if (tracked_objects_in->is_present) {
            self->node->objectsCallback(tracked_objects_in->value);
        }
    =}
}

main reactor {
    mbp = new map_based_prediction();
}
