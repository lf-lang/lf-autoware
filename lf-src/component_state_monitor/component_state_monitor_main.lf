/**
 * LF reactor wrapping the Autoware component_state_monitor.
 *
 * Timer-driven: monitors component topic states.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "main.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor component_state_monitor {
    state node:autoware::component_state_monitor::StateMonitor*;
    state node_shared_ptr:std::shared_ptr<autoware::component_state_monitor::StateMonitor>;

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + COMPONENT_STATE_MONITOR_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        self->node = new autoware::component_state_monitor::StateMonitor(nodeOptions);
        self->node->timer_->cancel();
        self->node_shared_ptr = std::shared_ptr<autoware::component_state_monitor::StateMonitor>(self->node);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::component_state_monitor::StateMonitor>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::component_state_monitor::StateMonitor>(self->node_shared_ptr)));
    =}

    timer t(0, 1000 msec);
    reaction (t) {=
        self->node->on_timer();
    =}
}

main reactor {
    csm = new component_state_monitor();
}
