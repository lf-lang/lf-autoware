/**
 * LF reactor wrapping the Autoware component_state_monitor.
 *
 * Timer-driven: monitors component topic states.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "main.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor component_state_monitor {
    state node:autoware::component_state_monitor::StateMonitor*;
    state node_shared_ptr:std::shared_ptr<autoware::component_state_monitor::StateMonitor>;

    reaction (startup) {=
        // component_state_monitor's "topics.yaml" is a list of topic configs
        // meant to be parsed by the launch system into per-module std::vector<std::string>
        // parameters (launch.sensing, autonomous.control, …). It is NOT a valid
        // ROS param YAML — loading it with get_node_options_from_yaml fails.
        // Until the python-launch substitution is reimplemented here, start the
        // node with default (empty) topic lists — it will report STALE for
        // every module but won't crash the federation.
        // rclcpp::init() is normally called inside get_node_options_from_yaml;
        // we skip that function here, so initialise explicitly.
        try { rclcpp::init(0, NULL); } catch (...) { }
        rclcpp::NodeOptions nodeOptions;

        self->node = new autoware::component_state_monitor::StateMonitor(nodeOptions);
        self->node->timer_->cancel();
        self->node_shared_ptr = std::shared_ptr<autoware::component_state_monitor::StateMonitor>(self->node);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::component_state_monitor::StateMonitor>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::component_state_monitor::StateMonitor>(self->node_shared_ptr)));
    =}

    timer t(0, 1000 msec);
    reaction (t) {=
        self->node->on_timer();
    =}
}

main reactor {
    csm = new component_state_monitor();
}
