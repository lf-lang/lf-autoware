/**
 * LF reactor wrapping the Autoware StopFilterNode.
 *
 * Subscription-driven: filters twist near vehicle standstill.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "stop_filter_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor stop_filter {
    input kinematic_state_in:std::shared_ptr<nav_msgs::msg::Odometry>;
    state node:{= std::shared_ptr<autoware::stop_filter::StopFilterNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + STOP_FILTER_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        self->node = std::make_shared<autoware::stop_filter::StopFilterNode>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::stop_filter::StopFilterNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::stop_filter::StopFilterNode>(self->node)));
    =}

    // LF input: kinematic_state_in (forwarded via spin thread until C++ interception added)
    reaction (kinematic_state_in) {=
        // TODO: call node callback directly once C++ header is modified
        // For now, the spin thread picks up data via ROS subscription
    =}
}

main reactor {
    sf = new stop_filter();
}
