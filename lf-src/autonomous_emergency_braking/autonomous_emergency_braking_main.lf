target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/autonomous_emergency_braking/node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor autonomous_emergency_braking {
    input obstacle_pointcloud_in:std::shared_ptr<sensor_msgs::msg::PointCloud2>;
    input predicted_objects_in:std::shared_ptr<autoware_perception_msgs::msg::PredictedObjects>;
    state node:{= std::shared_ptr<autoware::motion::control::autonomous_emergency_braking::AEB> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {home + "/" + AUTONOMOUS_EMERGENCY_BRAKING_PARAM, "/**"},
            {home + "/" + VEHICLE_INFO_PARAM, "/**"}
        });

        self->node = std::make_shared<autoware::motion::control::autonomous_emergency_braking::AEB>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::motion::control::autonomous_emergency_braking::AEB>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::motion::control::autonomous_emergency_braking::AEB>(self->node)));
    =}
}

main reactor {
    aeb = new autonomous_emergency_braking();
}
