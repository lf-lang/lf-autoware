target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "traffic_light_classifier_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor traffic_light_classifier {
    output signals_out:std::shared_ptr<autoware_perception_msgs::msg::TrafficLightGroupArray>;
    state node:{= std::shared_ptr<autoware::traffic_light::TrafficLightClassifierNodelet> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + TRAFFIC_LIGHT_CLASSIFIER_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        // label_path and model_path are set via launch args from data_path
        std::string data_path = get_default_data_path();
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("label_path",
                data_path + "/traffic_light_classifier/lamp_labels.txt"));
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("model_path",
                data_path + "/traffic_light_classifier/traffic_light_classifier_mobilenetv2_batch_6.onnx"));

        self->node = std::make_shared<autoware::traffic_light::TrafficLightClassifierNodelet>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::traffic_light::TrafficLightClassifierNodelet>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::traffic_light::TrafficLightClassifierNodelet>(self->node)));
    =}
}

main reactor {
    tlc = new traffic_light_classifier();
}
