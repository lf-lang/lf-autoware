target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
}

preamble {=
    #include "autoware/planning_validator/node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor planning_validator {
    // Output to trajectory_follower (final validated trajectory).
    // All upstream data (route, map, pointcloud, kinematics, acceleration,
    // operation_mode, trajectory) flows into the node via its own ROS
    // subscriptions (spin thread). The timer below polls the node's
    // lf_traj_is_set flag — set by onTrajectory when a new validated
    // trajectory is ready — and emits it over the LF port.
    output traj_out:std::shared_ptr<autoware_planning_msgs::msg::Trajectory>;

    state node:autoware::planning_validator::PlanningValidatorNode*;
    state spinner_thread:{= pthread_t =}
    state spinner_started:bool = false

    reaction (startup) {=
        std::string home = get_lf_autoware_home();

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {home + "/" + PLANNING_VALIDATOR_PARAM, "/**"},
            {home + "/" + PLANNING_VALIDATOR_LATENCY_CHECKER_PARAM, "/**"},
            {home + "/" + PLANNING_VALIDATOR_TRAJECTORY_CHECKER_PARAM, "/**"},
            {home + "/" + PLANNING_VALIDATOR_INTERSECTION_COLLISION_CHECKER_PARAM, "/**"},
            {home + "/" + PLANNING_VALIDATOR_REAR_COLLISION_CHECKER_PARAM, "/**"},
            {home + "/" + VEHICLE_INFO_PARAM, "/**"}
        });

        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("launch_modules", std::vector<std::string>{
                "autoware::planning_validator::LatencyChecker",
                "autoware::planning_validator::TrajectoryChecker",
                "autoware::planning_validator::IntersectionCollisionChecker",
                "autoware::planning_validator::RearCollisionChecker",
                ""
            }));

        self->node = new autoware::planning_validator::PlanningValidatorNode(nodeOptions);
        pthread_create(
            &self->spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::planning_validator::PlanningValidatorNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::planning_validator::PlanningValidatorNode>(
                    self->node, [](autoware::planning_validator::PlanningValidatorNode*) {})));
        self->spinner_started = true;
    =}

    // Poll the intercepted output at 33Hz. onTrajectory (fired by the ROS
    // subscription) sets lf_traj_is_set; this timer relays to the LF port.
    timer t(30 msec, 30 msec);
    reaction (t) -> traj_out {=
        if (self->node->lf_traj_is_set) {
            auto msg = std::make_shared<autoware_planning_msgs::msg::Trajectory>(
                self->node->lf_output_traj);
            lf_set(traj_out, msg);
            self->node->lf_traj_is_set = false;
        }
    =}

    reaction (shutdown) {=
        if (rclcpp::ok()) {
            rclcpp::shutdown();
        }

        if (self->spinner_started) {
            pthread_join(self->spinner_thread, NULL);
            self->spinner_started = false;
        }

        delete self->node;
        self->node = nullptr;
    =}
}

main reactor {
    pv = new planning_validator()
}
