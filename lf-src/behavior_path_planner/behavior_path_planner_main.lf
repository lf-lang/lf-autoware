/**
 * LF reactor wrapping the Autoware Universe BehaviorPathPlannerNode.
 *
 * This node is timer-driven (10Hz): polls route, map, odometry, acceleration,
 * scenario, perception, occupancy grid, costmap, traffic signals, lateral
 * offset, operation mode, and velocity limit via InterProcessPollingSubscriber,
 * then produces a path with lane id, turn signal, and hazard signal.
 *
 * The ROS2 timer is replaced by an LF timer. The spin thread keeps
 * polling subscribers and TF alive.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/behavior_path_planner/behavior_path_planner_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor behavior_path_planner {
    input occupancy_grid_in:std::shared_ptr<nav_msgs::msg::OccupancyGrid>;
    input route_in:std::shared_ptr<autoware_planning_msgs::msg::LaneletRoute>;
    input vector_map_in:std::shared_ptr<autoware_map_msgs::msg::LaneletMapBin>;
    input predicted_objects_in:std::shared_ptr<autoware_perception_msgs::msg::PredictedObjects>;
    input kinematic_state_in:std::shared_ptr<nav_msgs::msg::Odometry>;
    input acceleration_in:std::shared_ptr<geometry_msgs::msg::AccelWithCovarianceStamped>;
    output path_out:std::shared_ptr<autoware_internal_planning_msgs::msg::PathWithLaneId>;
    output turn_signal_out:std::shared_ptr<autoware_vehicle_msgs::msg::TurnIndicatorsCommand>;
    output hazard_signal_out:std::shared_ptr<autoware_vehicle_msgs::msg::HazardLightsCommand>;

    state node:autoware::behavior_path_planner::BehaviorPathPlannerNode*;
    state node_shared_ptr:std::shared_ptr<autoware::behavior_path_planner::BehaviorPathPlannerNode>;

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string common_param_path = home + "/" + PLANNING_COMMON_PARAM;
        std::string nearest_search_path = home + "/" + PLANNING_NEAREST_SEARCH_PARAM;
        std::string yaml_path = home + "/" + BEHAVIOR_PATH_PLANNER_PARAM;
        std::string drivable_area_path = home + "/" + BEHAVIOR_PATH_PLANNER_DRIVABLE_AREA_PARAM;
        std::string scene_manager_path = home + "/" + BEHAVIOR_PATH_PLANNER_SCENE_MANAGER_PARAM;
        std::string side_shift_path = home + "/" + BEHAVIOR_PATH_PLANNER_SIDE_SHIFT_PARAM;
        std::string avoidance_path = home + "/" + BEHAVIOR_PATH_PLANNER_AVOIDANCE_PARAM;
        std::string avoidance_by_lc_path = home + "/" + BEHAVIOR_PATH_PLANNER_AVOIDANCE_BY_LC_PARAM;
        std::string dynamic_avoidance_path = home + "/" + BEHAVIOR_PATH_PLANNER_DYNAMIC_AVOIDANCE_PARAM;
        std::string lane_change_path = home + "/" + BEHAVIOR_PATH_PLANNER_LANE_CHANGE_PARAM;
        std::string goal_planner_path = home + "/" + BEHAVIOR_PATH_PLANNER_GOAL_PLANNER_PARAM;
        std::string start_planner_path = home + "/" + BEHAVIOR_PATH_PLANNER_START_PLANNER_PARAM;
        std::string bidirectional_path = home + "/" + BEHAVIOR_PATH_PLANNER_BIDIRECTIONAL_TRAFFIC_PARAM;
        std::string sampling_path = home + "/" + BEHAVIOR_PATH_PLANNER_SAMPLING_PARAM;
        std::string vehicle_info_path = home + "/" + VEHICLE_INFO_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {common_param_path, "/**"},
            {nearest_search_path, "/**"},
            {yaml_path, "/**"},
            {drivable_area_path, "/**"},
            {scene_manager_path, "/**"},
            {side_shift_path, "/**"},
            {avoidance_path, "/**"},
            {avoidance_by_lc_path, "/**"},
            {dynamic_avoidance_path, "/**"},
            {lane_change_path, "/**"},
            {goal_planner_path, "/**"},
            {start_planner_path, "/**"},
            {bidirectional_path, "/**"},
            {sampling_path, "/**"},
            {vehicle_info_path, "/**"}
        });

        // Set launch-time parameters
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("launch_modules", std::vector<std::string>{}));

        self->node = new autoware::behavior_path_planner::BehaviorPathPlannerNode(nodeOptions);

        // Cancel the internal ROS2 timer (we use LF timer instead)
        self->node->timer_->cancel();

        self->node_shared_ptr = std::shared_ptr<
            autoware::behavior_path_planner::BehaviorPathPlannerNode>(self->node);

        // Start spin thread for polling subscribers and TF
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::behavior_path_planner::BehaviorPathPlannerNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::behavior_path_planner::BehaviorPathPlannerNode>(
                    self->node_shared_ptr)));
    =}

    // Timer at 100ms (10Hz, matching default behavior_path_planner rate)
    timer t(0, 100 msec);
    reaction (t) -> path_out, turn_signal_out, hazard_signal_out {=
        self->node->run();

        if (self->node->lf_path_is_set) {
            auto msg = std::make_shared<autoware_internal_planning_msgs::msg::PathWithLaneId>(
                self->node->lf_output_path);
            lf_set(path_out, msg);
            self->node->lf_path_is_set = false;
        }
        if (self->node->lf_turn_signal_is_set) {
            auto msg = std::make_shared<autoware_vehicle_msgs::msg::TurnIndicatorsCommand>(
                self->node->lf_output_turn_signal);
            lf_set(turn_signal_out, msg);
            self->node->lf_turn_signal_is_set = false;
        }
        if (self->node->lf_hazard_signal_is_set) {
            auto msg = std::make_shared<autoware_vehicle_msgs::msg::HazardLightsCommand>(
                self->node->lf_output_hazard_signal);
            lf_set(hazard_signal_out, msg);
            self->node->lf_hazard_signal_is_set = false;
        }
    =}
}

main reactor {
    bpp = new behavior_path_planner();
}
