/**
 * LF reactor wrapping the Autoware ProcessingTimeChecker.
 *
 * Timer-driven: monitors node processing times.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "processing_time_checker.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor processing_time_checker {
    state node:autoware::processing_time_checker::ProcessingTimeChecker*;
    state node_shared_ptr:std::shared_ptr<autoware::processing_time_checker::ProcessingTimeChecker>;

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + PROCESSING_TIME_CHECKER_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        // Launch-time parameters not declared in the param YAML.
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("output_metrics", false));

        self->node = new autoware::processing_time_checker::ProcessingTimeChecker(nodeOptions);
        self->node->timer_->cancel();
        self->node_shared_ptr = std::shared_ptr<autoware::processing_time_checker::ProcessingTimeChecker>(self->node);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::processing_time_checker::ProcessingTimeChecker>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::processing_time_checker::ProcessingTimeChecker>(self->node_shared_ptr)));
    =}

    timer t(0, 1000 msec);
    reaction (t) {=
        self->node->on_timer();
    =}
}

main reactor {
    ptc = new processing_time_checker();
}
