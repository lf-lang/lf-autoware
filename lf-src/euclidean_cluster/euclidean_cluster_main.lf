target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "voxel_grid_based_euclidean_cluster_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor euclidean_cluster {
    input pointcloud_in:std::shared_ptr<sensor_msgs::msg::PointCloud2>;
    output objects_out:std::shared_ptr<autoware_perception_msgs::msg::DetectedObjects>;
    state node:{= std::shared_ptr<autoware::euclidean_cluster::VoxelGridBasedEuclideanClusterNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + EUCLIDEAN_CLUSTER_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        self->node = std::make_shared<autoware::euclidean_cluster::VoxelGridBasedEuclideanClusterNode>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::euclidean_cluster::VoxelGridBasedEuclideanClusterNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::euclidean_cluster::VoxelGridBasedEuclideanClusterNode>(self->node)));
    =}
}

main reactor {
    ec = new euclidean_cluster();
}
