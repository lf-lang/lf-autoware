/**
 * LF reactor wrapping the Autoware Universe LidarCenterPointNode.
 *
 * Subscription-driven node: DNN-based 3D object detection from point clouds.
 * Runs passively via ROS callbacks in the spin thread.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/lidar_centerpoint/node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor lidar_centerpoint {
    input pointcloud_in:std::shared_ptr<sensor_msgs::msg::PointCloud2>;
    // Output: detected objects
    output objects_out:std::shared_ptr<autoware_perception_msgs::msg::DetectedObjects>;
    state node:{= std::shared_ptr<autoware::lidar_centerpoint::LidarCenterPointNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + LIDAR_CENTERPOINT_PARAM;
        std::string common_path = home + "/" + LIDAR_CENTERPOINT_COMMON_PARAM;
        std::string data_path = get_default_data_path();
        std::string ml_pkg_path = data_path + "/" + LIDAR_CENTERPOINT_ML_PACKAGE_PARAM;
        std::string class_remapper_path = data_path + "/" + LIDAR_CENTERPOINT_CLASS_REMAPPER_PARAM;

        // The centerpoint YAML contains $(var model_path) and $(var model_name)
        // launch substitutions. Resolve them before loading.
        std::string model_dir = data_path + "/lidar_centerpoint";
        std::string model_name = "centerpoint_tiny";
        std::string resolved_yaml = resolve_yaml_vars(yaml_path, {
            {"$(var model_path)", model_dir},
            {"$(var model_name)", model_name}
        });

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {resolved_yaml, "/**"},
            {common_path, "/**"},
            {ml_pkg_path, "/**"},
            {class_remapper_path, "/**"}
        });

        self->node = std::make_shared<autoware::lidar_centerpoint::LidarCenterPointNode>(nodeOptions);

        // Start spin thread for subscription callbacks
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::lidar_centerpoint::LidarCenterPointNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::lidar_centerpoint::LidarCenterPointNode>(self->node)));
    =}
}

main reactor {
    lcp = new lidar_centerpoint();
}
