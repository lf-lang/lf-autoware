target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor motion_velocity_planner {
    input occupancy_grid_in:std::shared_ptr<nav_msgs::msg::OccupancyGrid>;
    input vector_map_in:std::shared_ptr<autoware_map_msgs::msg::LaneletMapBin>;
    input predicted_objects_in:std::shared_ptr<autoware_perception_msgs::msg::PredictedObjects>;
    input kinematic_state_in:std::shared_ptr<nav_msgs::msg::Odometry>;
    input acceleration_in:std::shared_ptr<geometry_msgs::msg::AccelWithCovarianceStamped>;
    // Input from path_optimizer
    input traj_in:std::shared_ptr<autoware_planning_msgs::msg::Trajectory>;
    // Output to scenario_selector (lane_driving trajectory)
    output traj_out:std::shared_ptr<autoware_planning_msgs::msg::Trajectory>;

    state node:{= std::shared_ptr<autoware::motion_velocity_planner::MotionVelocityPlannerNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {home + "/" + PLANNING_COMMON_PARAM, "/**"},
            {home + "/" + VEHICLE_INFO_PARAM, "/**"},
            {home + "/" + PLANNING_NEAREST_SEARCH_PARAM, "/**"},
            {home + "/" + VELOCITY_SMOOTHER_PARAM, "/**"},
            {home + "/" + VELOCITY_SMOOTHER_ALGORITHM_PARAM, "/**"},
            {home + "/" + MOTION_VELOCITY_PLANNER_PARAM, "/**"},
            {home + "/" + MOTION_VELOCITY_PLANNER_OBSTACLE_STOP_PARAM, "/**"},
            {home + "/" + MOTION_VELOCITY_PLANNER_OBSTACLE_SLOW_DOWN_PARAM, "/**"},
            {home + "/" + MOTION_VELOCITY_PLANNER_OBSTACLE_CRUISE_PARAM, "/**"},
            {home + "/" + MOTION_VELOCITY_PLANNER_DYNAMIC_OBSTACLE_STOP_PARAM, "/**"},
            {home + "/" + MOTION_VELOCITY_PLANNER_OUT_OF_LANE_PARAM, "/**"},
            {home + "/" + MOTION_VELOCITY_PLANNER_OBSTACLE_VELOCITY_LIMITER_PARAM, "/**"},
            {home + "/" + MOTION_VELOCITY_PLANNER_RUN_OUT_PARAM, "/**"},
            {home + "/" + MOTION_VELOCITY_PLANNER_BOUNDARY_DEPARTURE_PREVENTION_PARAM, "/**"},
            {home + "/" + MOTION_VELOCITY_PLANNER_ROAD_USER_STOP_PARAM, "/**"}
        });

        // launch_modules parameter (list of module plugins)
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("launch_modules", std::vector<std::string>{
                "autoware::motion_velocity_planner::ObstacleStopModule",
                "autoware::motion_velocity_planner::ObstacleSlowDownModule",
                "autoware::motion_velocity_planner::ObstacleCruiseModule",
                "autoware::motion_velocity_planner::OutOfLaneModule",
                "autoware::motion_velocity_planner::ObstacleVelocityLimiterModule",
                "autoware::motion_velocity_planner::DynamicObstacleStopModule",
                "autoware::motion_velocity_planner::RunOutModule",
                "autoware::motion_velocity_planner::experimental::BoundaryDeparturePreventionModule",
                "autoware::motion_velocity_planner::RoadUserStopModule",
                ""
            }));

        self->node = std::make_shared<autoware::motion_velocity_planner::MotionVelocityPlannerNode>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::motion_velocity_planner::MotionVelocityPlannerNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::motion_velocity_planner::MotionVelocityPlannerNode>(self->node)));
    =}

    reaction (traj_in) -> traj_out {=
        if (traj_in->is_present) {
            self->node->on_trajectory(traj_in->value);
            if (self->node->lf_traj_is_set) {
                auto msg = std::make_shared<autoware_planning_msgs::msg::Trajectory>(
                    self->node->lf_output_traj);
                lf_set(traj_out, msg);
                self->node->lf_traj_is_set = false;
            }
        }
    =}
}

main reactor {
    mvp = new motion_velocity_planner();
}
