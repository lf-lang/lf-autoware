/**
 * Planning sub-reactor: groups all planning nodes.
 */
target CCpp;

import mission_planner from "../mission_planner/mission_planner_main.lf";
import behavior_path_planner from "../behavior_path_planner/behavior_path_planner_main.lf";
import behavior_velocity_planner from "../behavior_velocity_planner/behavior_velocity_planner_main.lf";
import path_smoother from "../path_smoother/path_smoother_main.lf";
import path_optimizer from "../path_optimizer/path_optimizer_main.lf";
import motion_velocity_planner from "../motion_velocity_planner/motion_velocity_planner_main.lf";
import surround_obstacle_checker from "../surround_obstacle_checker/surround_obstacle_checker_main.lf";
import scenario_selector from "../scenario_selector/scenario_selector_main.lf";
import velocity_smoother from "../velocity_smoother/velocity_smoother_main.lf";
import freespace_planner from "../freespace_planner/freespace_planner_main.lf";
import costmap_generator from "../costmap_generator/costmap_generator_main.lf";
import planning_validator from "../planning_validator/planning_validator_main.lf";
import external_velocity_limit_selector from "../external_velocity_limit_selector/external_velocity_limit_selector_main.lf";

reactor Planning {
    output trajectory_out:std::shared_ptr<autoware_planning_msgs::msg::Trajectory>;

    mp = new mission_planner();
    bpp = new behavior_path_planner();
    bvp = new behavior_velocity_planner();
    ps = new path_smoother();
    po = new path_optimizer();
    mvp = new motion_velocity_planner();
    soc = new surround_obstacle_checker();
    ss = new scenario_selector();
    vs = new velocity_smoother();
    fp = new freespace_planner();
    cg = new costmap_generator();
    pv = new planning_validator();
    evls = new external_velocity_limit_selector();

    ss.trajectory_out -> vs.trajectory_in;
    vs.trajectory_out -> trajectory_out;
}
