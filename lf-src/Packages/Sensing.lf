/**
 * Sensing sub-reactor: groups all sensing nodes.
 *
 * Contains:
 * - CropBoxFilter (x2): filters ego body and mirrors from pointcloud
 * - ImuCorrector: processes raw IMU data
 * - VehicleVelocityConverter: converts velocity status to twist
 */
target CCpp;

import crop_box_filter from "../crop_box_filter/crop_box_filter_main.lf";
import imu_corrector from "../imu_corrector/imu_corrector_main.lf";
import vehicle_velocity_converter from "../vehicle_velocity_converter/vehicle_velocity_converter_main.lf";

reactor Sensing {
    // Sensing nodes run passively via ROS subscriptions in spin threads.
    // No LF ports needed yet — data flows via ROS topics.
    cbf_self = new crop_box_filter();
    imu = new imu_corrector();
    vvc = new vehicle_velocity_converter();
}
