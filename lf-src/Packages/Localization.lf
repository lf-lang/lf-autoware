/**
 * Localization sub-reactor: groups all localization nodes.
 *
 * Contains:
 * - NDTScanMatcher: NDT-based pose estimation
 * - GyroOdometer: twist estimation from IMU/gyro
 * - EKFLocalizer: EKF fusion of pose + twist
 */
target CCpp;

import ndt_scan_matcher from "../ndt_scan_matcher/ndt_scan_matcher_main.lf";
import gyro_odometer from "../gyro_odometer/gyro_odometer_main.lf";
import ekf_localizer from "../ekf_localizer/ekf_localizer_main.lf";

reactor Localization {
    // Localization nodes run via ROS timers/subscriptions in spin threads.
    // No LF ports needed yet — data flows via ROS topics.
    ndt = new ndt_scan_matcher();
    gyro = new gyro_odometer();
    ekf = new ekf_localizer();
}
