/**
 * LF reactor wrapping the Autoware Core PoseInitializer.
 *
 * Service-driven node: handles initial pose estimation via GNSS or
 * manual input. Provides /localization/initialize service.
 * Runs passively via ROS callbacks in the spin thread.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "pose_initializer_core.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor pose_initializer {
    state node:{= std::shared_ptr<autoware::pose_initializer::PoseInitializer> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + POSE_INITIALIZER_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        // Configure for CARLA simulation (no GNSS, manual init)
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("gnss_enabled", false));
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("yabloc_enabled", false));
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("ndt_enabled", true));
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("ekf_enabled", true));

        self->node = std::make_shared<autoware::pose_initializer::PoseInitializer>(nodeOptions);

        // Start spin thread with executor (needs service callbacks + TF)
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node_with_executor<std::shared_ptr<autoware::pose_initializer::PoseInitializer>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::pose_initializer::PoseInitializer>(self->node)));
    =}
}

main reactor {
    pi = new pose_initializer();
}
