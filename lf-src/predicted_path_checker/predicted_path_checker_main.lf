/**
 * LF reactor wrapping the Autoware PredictedPathCheckerNode.
 *
 * Timer-driven: validates predicted paths for safety.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/predicted_path_checker/predicted_path_checker_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor predicted_path_checker {
    input predicted_objects_in:std::shared_ptr<autoware_perception_msgs::msg::PredictedObjects>;
    state node:autoware::predicted_path_checker::PredictedPathCheckerNode*;
    state node_shared_ptr:std::shared_ptr<autoware::predicted_path_checker::PredictedPathCheckerNode>;

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + PREDICTED_PATH_CHECKER_PARAM;
        std::string vehicle_info_path = home + "/" + VEHICLE_INFO_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {yaml_path, "/**"},
            {vehicle_info_path, "/**"}
        });

        self->node = new autoware::predicted_path_checker::PredictedPathCheckerNode(nodeOptions);
        self->node->timer_->cancel();
        self->node_shared_ptr = std::shared_ptr<autoware::predicted_path_checker::PredictedPathCheckerNode>(self->node);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::predicted_path_checker::PredictedPathCheckerNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::predicted_path_checker::PredictedPathCheckerNode>(self->node_shared_ptr)));
    =}

    timer t(0, 100 msec);
    reaction (t) {=
        self->node->onTimer();
    =}

    // LF input: predicted_objects_in
    reaction (predicted_objects_in) {=
        if (predicted_objects_in->is_present) {
            // predicted_objects stored for timer poll
        }
    =}
}

main reactor {
    ppc = new predicted_path_checker();
}
