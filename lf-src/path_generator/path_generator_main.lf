/**
 * LF reactor wrapping the Autoware PathGenerator.
 *
 * Timer-driven: generates reference paths for lane driving.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/path_generator/node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor path_generator {
    state node:autoware::path_generator::PathGenerator*;
    state node_shared_ptr:std::shared_ptr<autoware::path_generator::PathGenerator>;

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + PATH_GENERATOR_PARAM;
        std::string vehicle_info_path = home + "/" + VEHICLE_INFO_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {yaml_path, "/**"},
            {vehicle_info_path, "/**"}
        });

        self->node = new autoware::path_generator::PathGenerator(nodeOptions);
        self->node->timer_->cancel();
        self->node_shared_ptr = std::shared_ptr<autoware::path_generator::PathGenerator>(self->node);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::path_generator::PathGenerator>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::path_generator::PathGenerator>(self->node_shared_ptr)));
    =}

    timer t(0, 100 msec);
    reaction (t) {=
        self->node->run();
    =}
}

main reactor {
    pg = new path_generator();
}
