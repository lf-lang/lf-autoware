/**
 * LF reactor wrapping the Autoware Universe ImuCorrector.
 *
 * Subscription-driven node: corrects IMU data (bias, scale) and
 * republishes. Runs passively via ROS callbacks in the spin thread.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/imu_corrector/imu_corrector_core.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor imu_corrector {
    output imu_out:std::shared_ptr<sensor_msgs::msg::Imu>;
    state node:{= std::shared_ptr<autoware::imu_corrector::ImuCorrector> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + IMU_CORRECTOR_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");
        try { rclcpp::init(0, NULL); } catch (...) { }

        self->node = std::make_shared<autoware::imu_corrector::ImuCorrector>(nodeOptions);

        // Start spin thread for subscription callbacks
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::imu_corrector::ImuCorrector>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::imu_corrector::ImuCorrector>(self->node)));
    =}

    // Output polling: check if node produced output
    timer output_poll(100 msec, 100 msec);
    reaction (output_poll) -> imu_out {=
        if (self->node->lf_imu_is_set) {
            auto msg = std::make_shared<sensor_msgs::msg::Imu>(self->node->lf_output_imu);
            lf_set(imu_out, msg);
            self->node->lf_imu_is_set = false;
        }
    =}
}

main reactor {
    ic = new imu_corrector();
}
