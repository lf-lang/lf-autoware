target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/path_smoother/elastic_band_smoother.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor path_smoother {
    input kinematic_state_in:std::shared_ptr<nav_msgs::msg::Odometry>;
    // Input from behavior_velocity_planner
    input path_in:std::shared_ptr<autoware_planning_msgs::msg::Path>;
    // Output to path_optimizer (Path type, not Trajectory)
    output path_out:std::shared_ptr<autoware_planning_msgs::msg::Trajectory>;

    state node:{= std::shared_ptr<autoware::path_smoother::ElasticBandSmoother> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {home + "/" + PATH_SMOOTHER_PARAM, "/**"},
            {home + "/" + PLANNING_COMMON_PARAM, "/**"},
            {home + "/" + VEHICLE_INFO_PARAM, "/**"},
            {home + "/" + PLANNING_NEAREST_SEARCH_PARAM, "/**"}
        });

        self->node = std::make_shared<autoware::path_smoother::ElasticBandSmoother>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::path_smoother::ElasticBandSmoother>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::path_smoother::ElasticBandSmoother>(self->node)));
    =}

    // LF input: path from behavior_velocity_planner
    reaction (path_in) -> path_out {=
        if (path_in->is_present) {
            self->node->onPath(path_in->value);
            if (self->node->lf_traj_is_set) {
                auto msg = std::make_shared<autoware_planning_msgs::msg::Trajectory>(
                    self->node->lf_output_traj);
                lf_set(path_out, msg);
                self->node->lf_traj_is_set = false;
            }
        }
    =}
}

main reactor {
    ps = new path_smoother();
}
