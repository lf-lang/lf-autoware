/**
 * LF reactor wrapping the Autoware Universe FreespacePlannerNode.
 *
 * This node is timer-driven: polls occupancy_grid, scenario, and odometry
 * via InterProcessPollingSubscriber, performs A* or RRT* path search in
 * free space (for parking), and produces a trajectory.
 *
 * The ROS2 timer is replaced by an LF timer. The spin thread keeps
 * polling subscribers and TF alive.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/freespace_planner/freespace_planner_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor freespace_planner {
    input scenario_in:std::shared_ptr<autoware_internal_planning_msgs::msg::Scenario>;
    input route_in:std::shared_ptr<autoware_planning_msgs::msg::LaneletRoute>;
    input kinematic_state_in:std::shared_ptr<nav_msgs::msg::Odometry>;
    output trajectory_out:std::shared_ptr<autoware_planning_msgs::msg::Trajectory>;
    output is_completed:std::shared_ptr<bool>;

    state node:autoware::freespace_planner::FreespacePlannerNode*;
    state node_shared_ptr:std::shared_ptr<autoware::freespace_planner::FreespacePlannerNode>;

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + FREESPACE_PLANNER_PARAM;
        std::string vehicle_info_path = home + "/" + VEHICLE_INFO_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {yaml_path, "/**"},
            {vehicle_info_path, "/**"}
        });

        self->node = new autoware::freespace_planner::FreespacePlannerNode(nodeOptions);

        // Cancel the internal ROS2 timer (we use LF timer instead)
        self->node->timer_->cancel();

        self->node_shared_ptr = std::shared_ptr<autoware::freespace_planner::FreespacePlannerNode>(
            self->node);

        // Start spin thread for polling subscribers and TF
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::freespace_planner::FreespacePlannerNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::freespace_planner::FreespacePlannerNode>(
                    self->node_shared_ptr)));
    =}

    // Timer at 100ms (matching default update_rate of 10Hz)
    timer t(0, 100 msec);
    reaction (t) -> trajectory_out, is_completed {=
        self->node->onTimer();

        if (self->node->lf_trajectory_is_set) {
            auto msg = std::make_shared<autoware_planning_msgs::msg::Trajectory>(
                self->node->lf_output_trajectory);
            lf_set(trajectory_out, msg);
            self->node->lf_trajectory_is_set = false;
        }
        if (self->node->lf_is_completed_is_set) {
            auto val = std::make_shared<bool>(self->node->lf_is_completed);
            lf_set(is_completed, val);
            self->node->lf_is_completed_is_set = false;
        }
    =}

    // LF input: odometry
    reaction (kinematic_state_in) {=
        // Data delivered via LF connection at correct logical time
    =}

    // LF input: route
    reaction (route_in) {=
        // Data delivered via LF connection at correct logical time
    =}

    // LF input: scenario
    reaction (scenario_in) {=
        // Data delivered via LF connection at correct logical time
    =}
}

main reactor {
    fp = new freespace_planner();
}
