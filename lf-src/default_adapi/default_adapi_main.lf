/**
 * LF reactor wrapping autoware::default_adapi::VehicleInfoNode.
 *
 * The full Autoware default_adapi launch creates 15+ composable nodes, each
 * in the /adapi/node/<name> namespace, with FQN-scoped parameters from the
 * YAML. Creating them programmatically with a single NodeOptions bypasses
 * the namespace, so their declare_parameter<T>("update_rate") (and friends)
 * throw "must be initialized" at construction.
 *
 * Only VehicleInfoNode is actually needed by the driving path — it serves
 * /adapi/node/vehicle_info/get_parameters (consumed by the RViz planning-
 * factor overlay and other ADAPI clients). The other 14 sub-nodes are left
 * unlaunched; if they become necessary, the proper fix is to construct each
 * sub-node with a NodeOptions carrying "-r __node:=<n> -r __ns:=/adapi/node"
 * arguments so their FQN matches the YAML sections.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "vehicle_info.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor default_adapi {
    state node:{= std::shared_ptr<autoware::default_adapi::VehicleInfoNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + DEFAULT_ADAPI_PARAM;
        std::string vehicle_info_path = home + "/" + VEHICLE_INFO_PARAM;

        // Load both the adapi YAML (for any relevant overrides) and the
        // vehicle_info YAML (wheel_base, front_overhang, etc. that
        // VehicleInfoNode re-serves).
        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {yaml_path, "/**"},
            {vehicle_info_path, "/**"}
        });

        // Remap node to /adapi/node/vehicle_info so its service topic is
        // /adapi/node/vehicle_info/get_parameters (what PlanningFactorRvizPlugin
        // asks for).
        auto args = nodeOptions.arguments();
        args.insert(args.end(), {
            "-r", "__node:=vehicle_info",
            "-r", "__ns:=/adapi/node"
        });
        nodeOptions.arguments(args);

        self->node = std::make_shared<autoware::default_adapi::VehicleInfoNode>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::default_adapi::VehicleInfoNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::default_adapi::VehicleInfoNode>(self->node)));
    =}
}

main reactor {
    adapi = new default_adapi();
}
