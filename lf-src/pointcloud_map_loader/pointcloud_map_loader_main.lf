/**
 * LF reactor wrapping the Autoware Core PointCloudMapLoaderNode.
 *
 * Loads PCD pointcloud map files. Runs passively via ROS
 * callbacks in the spin thread.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "pointcloud_map_loader_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor pointcloud_map_loader {
    state node:{= std::shared_ptr<autoware::map_loader::PointCloudMapLoaderNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + POINTCLOUD_MAP_LOADER_PARAM;

        // The YAML contains $(var ...) launch substitutions that cannot be
        // parsed directly. Resolve them before loading.
        std::string map_path = get_default_map_path();
        std::string resolved_yaml = resolve_yaml_vars(yaml_path, {
            {"$(var pointcloud_map_path)", map_path + "/pointcloud_map.pcd"},
            {"$(var pointcloud_map_metadata_path)", map_path + "/pointcloud_map_metadata.yaml"}
        });

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            resolved_yaml.c_str(), "/**");

        // Town01 ships only the .pcd, not the metadata YAML the partial-load
        // service needs. Disable partial_load so the node falls back to
        // whole-PCD publish at startup.
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("enable_partial_load", false));

        // Remap the output topic into the /map/ namespace; without this the
        // PCD lands on /output/pointcloud_map (relative) and downstream
        // subscribers (NDT, occupancy_grid_map_filter, RViz) miss it.
        auto args = nodeOptions.arguments();
        args.insert(args.end(), {
            "-r", "output/pointcloud_map:=/map/pointcloud_map",
            "-r", "output/debug/downsampled_pointcloud_map:=/map/debug/downsampled_pointcloud_map",
            "-r", "service/get_partial_pcd_map:=/map/get_partial_pointcloud_map",
            "-r", "service/get_differential_pcd_map:=/map/get_differential_pointcloud_map",
            "-r", "service/get_selected_pcd_map:=/map/get_selected_pointcloud_map"
        });
        nodeOptions.arguments(args);

        try { rclcpp::init(0, NULL); } catch (...) { }

        self->node = std::make_shared<autoware::map_loader::PointCloudMapLoaderNode>(nodeOptions);

        // Start spin thread for subscription callbacks
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::map_loader::PointCloudMapLoaderNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::map_loader::PointCloudMapLoaderNode>(self->node)));
    =}
}

main reactor {
    pml = new pointcloud_map_loader();
}
