target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "obstacle_pointcloud_validator.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor object_validator {
    input objects_in:std::shared_ptr<autoware_perception_msgs::msg::DetectedObjects>;
    output objects_out:std::shared_ptr<autoware_perception_msgs::msg::DetectedObjects>;
    state node:{= std::shared_ptr<autoware::detected_object_validation::obstacle_pointcloud::ObstaclePointCloudBasedValidator> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + OBSTACLE_POINTCLOUD_VALIDATOR_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        self->node = std::make_shared<autoware::detected_object_validation::obstacle_pointcloud::ObstaclePointCloudBasedValidator>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::detected_object_validation::obstacle_pointcloud::ObstaclePointCloudBasedValidator>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::detected_object_validation::obstacle_pointcloud::ObstaclePointCloudBasedValidator>(self->node)));
    =}

    // LF input: objects_in (forwarded via spin thread until C++ interception added)
    reaction (objects_in) {=
        // TODO: call node callback directly once C++ header is modified
        // For now, the spin thread picks up data via ROS subscription
    =}
}

main reactor {
    ov = new object_validator();
}
