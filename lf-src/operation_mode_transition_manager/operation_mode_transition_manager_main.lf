target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor operation_mode_transition_manager {
    input trajectory_in:std::shared_ptr<autoware_planning_msgs::msg::Trajectory>;
    input control_cmd_in:std::shared_ptr<autoware_control_msgs::msg::Control>;
    output operation_mode_out:std::shared_ptr<autoware_adapi_v1_msgs::msg::OperationModeState>;
    input kinematic_state_in:std::shared_ptr<nav_msgs::msg::Odometry>;
    state node:{= std::shared_ptr<autoware::operation_mode_transition_manager::OperationModeTransitionManager> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {home + "/" + OPERATION_MODE_TRANSITION_MANAGER_PARAM, "/**"},
            {home + "/" + CONTROL_NEAREST_SEARCH_PARAM, "/**"},
            {home + "/" + VEHICLE_INFO_PARAM, "/**"}
        });

        self->node = std::make_shared<autoware::operation_mode_transition_manager::OperationModeTransitionManager>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::operation_mode_transition_manager::OperationModeTransitionManager>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::operation_mode_transition_manager::OperationModeTransitionManager>(self->node)));
    =}

    // LF input: kinematic_state_in
    reaction (kinematic_state_in) {=
        if (kinematic_state_in->is_present) {
            // kinematic_state stored for timer poll
        }
    =}
}

main reactor {
    omtm = new operation_mode_transition_manager();
}
