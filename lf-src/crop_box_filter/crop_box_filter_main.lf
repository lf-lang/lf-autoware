/**
 * LF reactor wrapping the Autoware Core CropBoxFilter.
 *
 * Subscription-driven node: filters point clouds by a crop box region.
 * Runs passively via ROS callbacks in the spin thread.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/crop_box_filter/crop_box_filter_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor crop_box_filter {
    output pointcloud_out:std::shared_ptr<sensor_msgs::msg::PointCloud2>;
    state node:{= std::shared_ptr<autoware::crop_box_filter::CropBoxFilter> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string crop_box_path = home + "/" + CROP_BOX_FILTER_PARAM;
        std::string vehicle_info_path = home + "/" + VEHICLE_INFO_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {crop_box_path, "/**"},
            {vehicle_info_path, "/**"}
        });

        self->node = std::make_shared<autoware::crop_box_filter::CropBoxFilter>(nodeOptions);

        // Start spin thread for subscription callbacks
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::crop_box_filter::CropBoxFilter>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::crop_box_filter::CropBoxFilter>(self->node)));
    =}

    // Output polling: check if node produced output
    timer output_poll(100 msec, 100 msec);
    reaction (output_poll) -> pointcloud_out {=
        if (self->node->lf_cloud_is_set) {
            auto msg = std::make_shared<sensor_msgs::msg::PointCloud2>(self->node->lf_output_cloud);
            lf_set(pointcloud_out, msg);
            self->node->lf_cloud_is_set = false;
        }
    =}
}

main reactor {
    cbf = new crop_box_filter();
}
