/**
 * Top-level federated reactor for the LF-Autoware Universe integration.
 *
 * Architecture (Phase 2):
 *
 * [AWSIM + Sensing + Localization + Perception]  <-- Standard ROS2 (unchanged)
 *         |
 *         v (ROS2 topics -> node spin threads)
 * +----------------------------------------------+
 * |            LF Federation                      |
 * |                                               |
 * |  Planning -----> Control -----> BridgeInterface --> ROS2 -> AWSIM
 * |  (federate)      (federate)     (federate)    |
 * +----------------------------------------------+
 *
 * In Phase 2 Option B:
 * - Each node keeps its ROS2 polling subscribers alive via spin thread
 * - Inter-node data primarily flows through ROS2 topics (via polling)
 * - LF provides deterministic scheduling of timer callbacks
 * - BridgeInterface publishes final commands back to ROS2 for AWSIM
 */
target CCpp {
    coordination: decentralized
};

import Planning from "Packages/Planning.lf";
import Control from "Packages/Control.lf";
import bridge_interface from "bridge_interface/bridge_interface_main.lf";

federated reactor AutowareUniverse {
    planning = new Planning();
    control = new Control();
    bridge = new bridge_interface();

    // Planning -> Control: trajectory flows via ROS2 polling subscribers
    // (Phase 2 Option B: nodes poll data from ROS2 topics in spin thread)

    // Control -> BridgeInterface: final commands published to ROS2
    control.control_cmd_out ~> bridge.control_cmd_in serializer "ros2";
    control.gear_cmd_out ~> bridge.gear_cmd_in serializer "ros2";
    control.turn_indicators_cmd_out ~> bridge.turn_indicators_cmd_in serializer "ros2";
    control.hazard_lights_cmd_out ~> bridge.hazard_lights_cmd_in serializer "ros2";
}
