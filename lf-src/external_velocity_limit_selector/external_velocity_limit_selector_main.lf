target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/external_velocity_limit_selector/external_velocity_limit_selector_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor external_velocity_limit_selector {
    output velocity_limit_out:std::shared_ptr<autoware_planning_msgs::msg::VelocityLimit>;
    state node:{= std::shared_ptr<autoware::external_velocity_limit_selector::ExternalVelocityLimitSelectorNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {home + "/" + EXTERNAL_VELOCITY_LIMIT_SELECTOR_COMMON_PARAM, "/**"},
            {home + "/" + EXTERNAL_VELOCITY_LIMIT_SELECTOR_PARAM, "/**"}
        });

        self->node = std::make_shared<autoware::external_velocity_limit_selector::ExternalVelocityLimitSelectorNode>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::external_velocity_limit_selector::ExternalVelocityLimitSelectorNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::external_velocity_limit_selector::ExternalVelocityLimitSelectorNode>(self->node)));
    =}
}

main reactor {
    evls = new external_velocity_limit_selector();
}
