/**
 * LF reactor wrapping the Autoware Universe VehicleCmdGate.
 *
 * This is the most complex control node with 20+ subscribers, services,
 * and two timers. It acts as the command safety gate, filtering control
 * commands before sending them to the vehicle.
 *
 * Only the two LF-delivered inputs are exposed as LF ports:
 * - auto_control_cmd_in from trajectory_follower
 * - gear_cmd_in_from_sd from shift_decider
 *
 * Everything else (kinematics, acceleration, steering, engage, operation
 * mode, external turn/hazard commands) reaches the node through its own
 * ROS subscriptions in the spin thread. The internal ROS timers are
 * cancelled; the LF timer drives onTimer() + publishStatus() and relays
 * the four intercepted outputs over LF ports to bridge_interface.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
}

preamble {=
    #include "vehicle_cmd_gate.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor vehicle_cmd_gate {
    // Inputs from other LF control reactors.
    input auto_control_cmd_in:std::shared_ptr<autoware_control_msgs::msg::Control>;
    input gear_cmd_in_from_sd:std::shared_ptr<autoware_vehicle_msgs::msg::GearCommand>;

    // Outputs to bridge_interface.
    output control_cmd:std::shared_ptr<autoware_control_msgs::msg::Control>;
    output gear_cmd:std::shared_ptr<autoware_vehicle_msgs::msg::GearCommand>;
    output turn_indicators_cmd:std::shared_ptr<autoware_vehicle_msgs::msg::TurnIndicatorsCommand>;
    output hazard_lights_cmd:std::shared_ptr<autoware_vehicle_msgs::msg::HazardLightsCommand>;

    state node:autoware::vehicle_cmd_gate::VehicleCmdGate*;
    state spinner_thread:{= pthread_t =}
    state spinner_started:bool = false

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + VEHICLE_CMD_GATE_PARAM;
        std::string vehicle_info_path = home + "/" + VEHICLE_INFO_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {yaml_path, "/**"},
            {vehicle_info_path, "/**"}
        });

        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("check_external_emergency_heartbeat", false));
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("use_emergency_handling", false));
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("is_simulation", true));

        self->node = new autoware::vehicle_cmd_gate::VehicleCmdGate(nodeOptions);

        // Cancel the internal ROS2 timers — LF timer drives ticks.
        self->node->timer_->cancel();
        self->node->timer_pub_status_->cancel();

        pthread_create(
            &self->spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::vehicle_cmd_gate::VehicleCmdGate>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::vehicle_cmd_gate::VehicleCmdGate>(
                    self->node, [](autoware::vehicle_cmd_gate::VehicleCmdGate*) {})));
        self->spinner_started = true;
    =}

    reaction (gear_cmd_in_from_sd) {=
        if (gear_cmd_in_from_sd->is_present) {
            self->node->onAutoGearCmd(gear_cmd_in_from_sd->value);
        }
    =}

    reaction (auto_control_cmd_in) {=
        if (auto_control_cmd_in->is_present) {
            self->node->onAutoCtrlCmd(auto_control_cmd_in->value);
        }
    =}

    timer t(10 msec, 50 msec);
    reaction (t) -> control_cmd, gear_cmd, turn_indicators_cmd, hazard_lights_cmd {=
        self->node->onTimer();

        if (self->node->lf_control_cmd_is_set) {
            auto msg = std::make_shared<autoware_control_msgs::msg::Control>(
                self->node->lf_output_control_cmd);
            lf_set(control_cmd, msg);
            self->node->lf_control_cmd_is_set = false;
        }
        if (self->node->lf_gear_cmd_is_set) {
            auto msg = std::make_shared<autoware_vehicle_msgs::msg::GearCommand>(
                self->node->lf_output_gear_cmd);
            lf_set(gear_cmd, msg);
            self->node->lf_gear_cmd_is_set = false;
        }
        if (self->node->lf_turn_indicators_is_set) {
            auto msg = std::make_shared<autoware_vehicle_msgs::msg::TurnIndicatorsCommand>(
                self->node->lf_output_turn_indicators_cmd);
            lf_set(turn_indicators_cmd, msg);
            self->node->lf_turn_indicators_is_set = false;
        }
        if (self->node->lf_hazard_lights_is_set) {
            auto msg = std::make_shared<autoware_vehicle_msgs::msg::HazardLightsCommand>(
                self->node->lf_output_hazard_lights_cmd);
            lf_set(hazard_lights_cmd, msg);
            self->node->lf_hazard_lights_is_set = false;
        }

        self->node->publishStatus();
    =}

    reaction (shutdown) {=
        if (rclcpp::ok()) {
            rclcpp::shutdown();
        }

        if (self->spinner_started) {
            pthread_join(self->spinner_thread, NULL);
            self->spinner_started = false;
        }

        delete self->node;
        self->node = nullptr;
    =}
}

main reactor {
    vcg = new vehicle_cmd_gate()
}
