target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "detected_object_lanelet_filter.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor object_filter {
    input objects_in:std::shared_ptr<autoware_perception_msgs::msg::DetectedObjects>;
    output objects_out:std::shared_ptr<autoware_perception_msgs::msg::DetectedObjects>;
    state node:{= std::shared_ptr<autoware::detected_object_validation::lanelet_filter::DetectedObjectLaneletFilterNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + OBJECT_LANELET_FILTER_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        self->node = std::make_shared<autoware::detected_object_validation::lanelet_filter::DetectedObjectLaneletFilterNode>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::detected_object_validation::lanelet_filter::DetectedObjectLaneletFilterNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::detected_object_validation::lanelet_filter::DetectedObjectLaneletFilterNode>(self->node)));
    =}

    // LF input: objects_in (forwarded via spin thread until C++ interception added)
    reaction (objects_in) {=
        // TODO: call node callback directly once C++ header is modified
        // For now, the spin thread picks up data via ROS subscription
    =}
}

main reactor {
    of = new object_filter();
}
