/**
 * LF reactor wrapping the Autoware ObstacleCollisionCheckerNode.
 *
 * Timer-driven: checks collisions with obstacles.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/obstacle_collision_checker/obstacle_collision_checker_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor obstacle_collision_checker {
    state node:autoware::obstacle_collision_checker::ObstacleCollisionCheckerNode*;
    state node_shared_ptr:std::shared_ptr<autoware::obstacle_collision_checker::ObstacleCollisionCheckerNode>;

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + OBSTACLE_COLLISION_CHECKER_PARAM;
        std::string vehicle_info_path = home + "/" + VEHICLE_INFO_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {yaml_path, "/**"},
            {vehicle_info_path, "/**"}
        });

        self->node = new autoware::obstacle_collision_checker::ObstacleCollisionCheckerNode(nodeOptions);
        self->node->timer_->cancel();
        self->node_shared_ptr = std::shared_ptr<autoware::obstacle_collision_checker::ObstacleCollisionCheckerNode>(self->node);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::obstacle_collision_checker::ObstacleCollisionCheckerNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::obstacle_collision_checker::ObstacleCollisionCheckerNode>(self->node_shared_ptr)));
    =}

    timer t(0, 100 msec);
    reaction (t) {=
        self->node->on_timer();
    =}
}

main reactor {
    occ = new obstacle_collision_checker();
}
