/**
 * LF reactor wrapping the Autoware Core EKFLocalizer.
 *
 * This node has a timer_control_ timer and subscription callbacks for
 * pose and twist measurements. For now, it runs entirely via ROS
 * in the spin thread.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/ekf_localizer/ekf_localizer.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor ekf_localizer {
    input pose_in:std::shared_ptr<geometry_msgs::msg::PoseWithCovarianceStamped>;
    input twist_in:std::shared_ptr<geometry_msgs::msg::TwistWithCovarianceStamped>;
    // Output: fused kinematic state (consumed by many nodes)
    output kinematic_state_out:std::shared_ptr<nav_msgs::msg::Odometry>;
    state node:{= std::shared_ptr<autoware::ekf_localizer::EKFLocalizer> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + EKF_LOCALIZER_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");
        try { rclcpp::init(0, NULL); } catch (...) { }

        self->node = std::make_shared<autoware::ekf_localizer::EKFLocalizer>(nodeOptions);

        // Start spin thread (timer + subscriptions run via ROS)
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::ekf_localizer::EKFLocalizer>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::ekf_localizer::EKFLocalizer>(self->node)));
    =}

    // LF input: pose_in
    reaction (pose_in) {=
        if (pose_in->is_present) {
            self->node->callback_pose_with_covariance(pose_in->value);
        }
    =}

    // LF input: twist_in
    reaction (twist_in) {=
        if (twist_in->is_present) {
            // twist stored for timer poll
        }
    =}

    // Output polling: check if node produced output
    timer output_poll(100 msec, 100 msec);
    reaction (output_poll) -> kinematic_state_out {=
        if (self->node->lf_odom_is_set) {
            auto msg = std::make_shared<nav_msgs::msg::Odometry>(self->node->lf_output_odom);
            lf_set(kinematic_state_out, msg);
            self->node->lf_odom_is_set = false;
        }
    =}
}

main reactor {
    ekf = new ekf_localizer();
}
