target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware_compare_map_segmentation/node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor pointcloud_map_filter {
    input pointcloud_in:std::shared_ptr<sensor_msgs::msg::PointCloud2>;
    output pointcloud_out:std::shared_ptr<sensor_msgs::msg::PointCloud2>;
    state node:{= std::shared_ptr<autoware::compare_map_segmentation::VoxelBasedApproximateCompareMapFilterComponent> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + COMPARE_MAP_FILTER_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        self->node = std::make_shared<autoware::compare_map_segmentation::VoxelBasedApproximateCompareMapFilterComponent>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::compare_map_segmentation::VoxelBasedApproximateCompareMapFilterComponent>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::compare_map_segmentation::VoxelBasedApproximateCompareMapFilterComponent>(self->node)));
    =}
}

main reactor {
    pmf = new pointcloud_map_filter();
}
