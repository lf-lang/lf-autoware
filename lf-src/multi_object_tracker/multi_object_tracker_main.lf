/**
 * LF reactor wrapping the Autoware Universe MultiObjectTracker.
 *
 * Subscription-driven node: tracks detected objects across frames.
 * Runs passively via ROS callbacks in the spin thread.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "multi_object_tracker_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor multi_object_tracker {
    // Input from detection pipeline
    input objects_in:std::shared_ptr<autoware_perception_msgs::msg::DetectedObjects>;
    // Output to map_based_prediction
    output tracked_objects_out:std::shared_ptr<autoware_perception_msgs::msg::TrackedObjects>;
    state node:{= std::shared_ptr<autoware::multi_object_tracker::MultiObjectTracker> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string tracker_path = home + "/" + MULTI_OBJECT_TRACKER_PARAM;
        std::string da_path = home + "/" + MULTI_OBJECT_TRACKER_DATA_ASSOCIATION_PARAM;
        std::string ic_path = home + "/" + MULTI_OBJECT_TRACKER_INPUT_CHANNELS_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {tracker_path, "/**"},
            {da_path, "/**"},
            {ic_path, "/**"}
        });

        // publish_merged_objects is set via launch arg, default false
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("publish_merged_objects", false));

        // Input detection channels: set via launch args.
        // Channel 01 = lidar_centerpoint, rest = none (disabled).
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("input/detection01/channel", std::string("lidar_centerpoint")));
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("input/detection01/objects",
                std::string("/perception/object_recognition/detection/centerpoint/objects")));
        for (int i = 2; i <= 12; i++) {
            std::string id = std::string("detection") + (i < 10 ? "0" : "") + std::to_string(i);
            nodeOptions.parameter_overrides().push_back(
                rclcpp::Parameter("input/" + id + "/channel", std::string("none")));
            nodeOptions.parameter_overrides().push_back(
                rclcpp::Parameter("input/" + id + "/objects", std::string("none")));
        }

        self->node = std::make_shared<autoware::multi_object_tracker::MultiObjectTracker>(nodeOptions);

        // Start spin thread for subscription callbacks
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::multi_object_tracker::MultiObjectTracker>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::multi_object_tracker::MultiObjectTracker>(self->node)));
    =}

    // LF input: objects_in
    reaction (objects_in) {=
        if (objects_in->is_present) {
            // objects fed via input_manager in spin thread
        }
    =}

    // Output polling: check if node produced output
    timer output_poll(100 msec, 100 msec);
    reaction (output_poll) -> tracked_objects_out {=
        if (self->node->lf_tracked_is_set) {
            auto msg = std::make_shared<autoware_perception_msgs::msg::TrackedObjects>(self->node->lf_output_tracked);
            lf_set(tracked_objects_out, msg);
            self->node->lf_tracked_is_set = false;
        }
    =}
}

main reactor {
    mot = new multi_object_tracker();
}
