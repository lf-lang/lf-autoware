target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    // Use full path to avoid ambiguity with other node.hpp files
    #include "autoware_traffic_light_occlusion_predictor/node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor traffic_light_occlusion_predictor {
    state node:{= std::shared_ptr<autoware::traffic_light::TrafficLightOcclusionPredictorNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + TRAFFIC_LIGHT_OCCLUSION_PREDICTOR_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        self->node = std::make_shared<autoware::traffic_light::TrafficLightOcclusionPredictorNode>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::traffic_light::TrafficLightOcclusionPredictorNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::traffic_light::TrafficLightOcclusionPredictorNode>(self->node)));
    =}
}

main reactor {
    tlop = new traffic_light_occlusion_predictor();
}
