target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/collision_detector/node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor collision_detector {
    input obstacle_pointcloud_in:std::shared_ptr<sensor_msgs::msg::PointCloud2>;
    input predicted_objects_in:std::shared_ptr<autoware_perception_msgs::msg::PredictedObjects>;
    input kinematic_state_in:std::shared_ptr<nav_msgs::msg::Odometry>;
    state node:{= std::shared_ptr<autoware::collision_detector::CollisionDetectorNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {home + "/" + COLLISION_DETECTOR_PARAM, "/**"},
            {home + "/" + VEHICLE_INFO_PARAM, "/**"}
        });

        self->node = std::make_shared<autoware::collision_detector::CollisionDetectorNode>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::collision_detector::CollisionDetectorNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::collision_detector::CollisionDetectorNode>(self->node)));
    =}

    // LF input: kinematic_state_in (forwarded via spin thread until C++ interception added)
    reaction (kinematic_state_in) {=
        // TODO: call node callback directly once C++ header is modified
        // For now, the spin thread picks up data via ROS subscription
    =}
}

main reactor {
    cd = new collision_detector();
}
