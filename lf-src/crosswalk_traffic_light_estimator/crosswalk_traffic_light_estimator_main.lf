target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware_crosswalk_traffic_light_estimator/node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor crosswalk_traffic_light_estimator {
    state node:{= std::shared_ptr<autoware::crosswalk_traffic_light_estimator::CrosswalkTrafficLightEstimatorNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + CROSSWALK_TRAFFIC_LIGHT_ESTIMATOR_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        self->node = std::make_shared<autoware::crosswalk_traffic_light_estimator::CrosswalkTrafficLightEstimatorNode>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::crosswalk_traffic_light_estimator::CrosswalkTrafficLightEstimatorNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::crosswalk_traffic_light_estimator::CrosswalkTrafficLightEstimatorNode>(self->node)));
    =}
}

main reactor {
    ctle = new crosswalk_traffic_light_estimator();
}
