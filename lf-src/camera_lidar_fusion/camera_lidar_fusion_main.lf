target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/image_projection_based_fusion/roi_cluster_fusion/node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor camera_lidar_fusion {
    input objects_in:std::shared_ptr<autoware_perception_msgs::msg::DetectedObjects>;
    output objects_out:std::shared_ptr<autoware_perception_msgs::msg::DetectedObjects>;
    state node:{= std::shared_ptr<autoware::image_projection_based_fusion::RoiClusterFusionNode> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string roi_path = home + "/" + ROI_CLUSTER_FUSION_PARAM;
        std::string common_path = home + "/" + FUSION_COMMON_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yamls({
            {roi_path, "/**"},
            {common_path, "/**"}
        });

        // rois_number is set via launch arg (number_of_cameras), default 1
        nodeOptions.parameter_overrides().push_back(
            rclcpp::Parameter("rois_number", 1));

        self->node = std::make_shared<autoware::image_projection_based_fusion::RoiClusterFusionNode>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::image_projection_based_fusion::RoiClusterFusionNode>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::image_projection_based_fusion::RoiClusterFusionNode>(self->node)));
    =}

    // LF input: objects_in
    reaction (objects_in) {=
        if (objects_in->is_present) {
            // objects processed via fusion node subscription
        }
    =}
}

main reactor {
    clf = new camera_lidar_fusion();
}
