target CCpp {
  cmake-include: [
      "../../../velocity_smoother/include/CMakeListsExtension.txt",
      "include/federate__vs_extension.cmake"],
  compile-definitions: {
    FEDERATED_DECENTRALIZED: "",
    EXECUTABLE_PREAMBLE: "",
    NUMBER_OF_FEDERATES: "46",
    FEDERATE_ID: "32",
    FEDERATED: "",
    LF_CLOCK_SYNC: "1",
    _LF_FEDERATE_NAMES_COMMA_SEPARATED: "\"federate__cbf,federate__imu,federate__vvc,federate__ndt,federate__gyro,federate__ekf,federate__pcm,federate__l2m,federate__gs,federate__lcp,federate__ec,federate__pmf,federate__dbt,federate__ov,federate__of,federate__clf,federate__mot,federate__mbp,federate__ogm,federate__tlmbd,federate__tlc,federate__tla,federate__tlop,federate__ctle,federate__mp,federate__bpp,federate__bvp,federate__ps,federate__po,federate__mvp,federate__soc,federate__ss,federate__vs,federate__fp,federate__cg,federate__pv,federate__evls,federate__tf,federate__sd,federate__vcg,federate__omtm,federate__ldc,federate__cv,federate__aeb,federate__cd,federate__bridge\""
  },
  coordination: "decentralized",
  _fed_setup: "include/_federate__vs_preamble.h",
  keepalive: true,
  single-threaded: false
}
import velocity_smoother from "../../../velocity_smoother/velocity_smoother_main.lf"

preamble {=
#include "autoware/velocity_smoother/node.hpp"
#include "utils.hpp"
#include "constants.hpp"
=}
preamble {=
#ifdef __cplusplus
extern "C" {
#endif
#include "core/federated/federate.h"
#include "core/federated/network/net_common.h"
#include "core/federated/network/net_util.h"
#include "core/federated/network/socket_common.h"
#include "core/federated/clock-sync.h"
#include "core/threaded/reactor_threaded.h"
#include "core/utils/util.h"
extern federate_instance_t _fed;
#ifdef __cplusplus
}
#endif
#include "rcutils/allocator.h"
#include "rclcpp/rclcpp.hpp"
#include "rclcpp/serialization.hpp"
#include "rclcpp/serialized_message.hpp"

=}

reactor _vstrajectory_in {
  input port0: std::shared_ptr<autoware_planning_msgs::msg::Trajectory>

  output[1] port: std::shared_ptr<autoware_planning_msgs::msg::Trajectory>

  port0 -> port
}
@_network_receiver
reactor NetworkReceiver_0 {
  output msg: std::shared_ptr<autoware_planning_msgs::msg::Trajectory>

  physical action networkMessage: uint8_t*

  reaction(networkMessage) -> msg {=
    msg->physical_time_of_arrival = self->_lf__networkMessage.physical_time_of_arrival;
    auto _lf_message = std::make_unique<rcl_serialized_message_t>( rcl_serialized_message_t{
        .buffer = (uint8_t*)self->_lf__networkMessage.tmplt.token->value,
        .buffer_length = self->_lf__networkMessage.tmplt.token->length,
        .buffer_capacity = self->_lf__networkMessage.tmplt.token->length,
        .allocator = rcl_get_default_allocator()
    });
    auto _lf_msg = std::make_unique<rclcpp::SerializedMessage>(std::move(*_lf_message.get()));
    self->_lf__networkMessage.tmplt.token->value = NULL; // Manually move the data
    using MessageT = autoware_planning_msgs::msg::Trajectory;
    MessageT deserialized_message = MessageT();
    auto _lf_serializer = rclcpp::Serialization<MessageT>();
    _lf_serializer.deserialize_message(_lf_msg.get(), &deserialized_message);
    auto msg_shared_ptr = std::make_shared<autoware_planning_msgs::msg::Trajectory>(deserialized_message);
    lf_set(msg, msg_shared_ptr);
  =}
}
@_fed_config()
main reactor  {

    vs = new velocity_smoother()
    
    
    
    
    
    
    nr_federate__vs = new NetworkReceiver_0()
    _vstrajectory_in0 = new _vstrajectory_in()
    _vstrajectory_in0.port -> vs.trajectory_in
    nr_federate__vs.msg -> _vstrajectory_in0.port0
}
