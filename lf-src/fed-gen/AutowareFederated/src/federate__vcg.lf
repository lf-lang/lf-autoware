@_network_sender
reactor NetworkSender_3<SENDERINDEXPARAMETER> {
  input[1] msg: std::shared_ptr<autoware_vehicle_msgs::msg::HazardLightsCommand>

  reaction(msg) {=
    // Sending from msg[0] in federate federate__vcg to bridge.hazard_lights_cmd_in in federate federate__bridge
    if (!msg[0]->is_present) {
