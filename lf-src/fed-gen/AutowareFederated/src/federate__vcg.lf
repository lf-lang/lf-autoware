target CCpp {
  cmake-include: [
      "../../../vehicle_cmd_gate/include/CMakeListsExtension.txt",
      "include/federate__vcg_extension.cmake"],
  compile-definitions: {
    FEDERATED_DECENTRALIZED: "",
    EXECUTABLE_PREAMBLE: "",
    NUMBER_OF_FEDERATES: "46",
    FEDERATE_ID: "39",
    FEDERATED: "",
    LF_CLOCK_SYNC: "1",
    _LF_FEDERATE_NAMES_COMMA_SEPARATED: "\"federate__cbf,federate__imu,federate__vvc,federate__ndt,federate__gyro,federate__ekf,federate__pcm,federate__l2m,federate__gs,federate__lcp,federate__ec,federate__pmf,federate__dbt,federate__ov,federate__of,federate__clf,federate__mot,federate__mbp,federate__ogm,federate__tlmbd,federate__tlc,federate__tla,federate__tlop,federate__ctle,federate__mp,federate__bpp,federate__bvp,federate__ps,federate__po,federate__mvp,federate__soc,federate__ss,federate__vs,federate__fp,federate__cg,federate__pv,federate__evls,federate__tf,federate__sd,federate__vcg,federate__omtm,federate__ldc,federate__cv,federate__aeb,federate__cd,federate__bridge\""
  },
  coordination: "decentralized",
  _fed_setup: "include/_federate__vcg_preamble.h",
  keepalive: true,
  single-threaded: false
}
import vehicle_cmd_gate from "../../../vehicle_cmd_gate/vehicle_cmd_gate_main.lf"

preamble {=
#include "vehicle_cmd_gate.hpp"
#include "utils.hpp"
#include "constants.hpp"
=}
preamble {=
#ifdef __cplusplus
extern "C" {
#endif
#include "core/federated/federate.h"
#include "core/federated/network/net_common.h"
#include "core/federated/network/net_util.h"
#include "core/federated/network/socket_common.h"
#include "core/federated/clock-sync.h"
#include "core/threaded/reactor_threaded.h"
#include "core/utils/util.h"
extern federate_instance_t _fed;
#ifdef __cplusplus
}
#endif
#include "rcutils/allocator.h"
#include "rclcpp/rclcpp.hpp"
#include "rclcpp/serialization.hpp"
#include "rclcpp/serialized_message.hpp"

=}

@_network_sender
reactor NetworkSender_0<SENDERINDEXPARAMETER> {
  input[1] msg: std::shared_ptr<autoware_control_msgs::msg::Control>

  reaction(msg) {=
    // Sending from msg[0] in federate federate__vcg to bridge.control_cmd_in in federate federate__bridge
    if (!msg[0]->is_present) {
    return;
    }
    rclcpp::SerializedMessage serialized_message(0u);
    using MessageT = autoware_control_msgs::msg::Control;
    static rclcpp::Serialization<MessageT> _lf_serializer;
    _lf_serializer.serialize_message(msg[0]->value.get() , &serialized_message);
    size_t _lf_message_length = serialized_message.size();
    lf_send_message(MSG_TYPE_P2P_MESSAGE, 0, 45, "federate 45", _lf_message_length, serialized_message.get_rcl_serialized_message().buffer);
  =}
}
