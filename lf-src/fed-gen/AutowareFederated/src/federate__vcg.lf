  =}
}
@_fed_config()
main reactor  {

    vcg = new vehicle_cmd_gate()
    
    
    
    
    
    ns_federate__bridge = new NetworkSender_0<{= 0 =}>()
    ns_federate__bridge_0 = new NetworkSender_1<{= 1 =}>()
    ns_federate__bridge_1 = new NetworkSender_2<{= 2 =}>()
    ns_federate__bridge_2 = new NetworkSender_3<{= 3 =}>()
    
    
    vcg.control_cmd -> ns_federate__bridge.msg
    vcg.gear_cmd -> ns_federate__bridge_0.msg
    vcg.turn_indicators_cmd -> ns_federate__bridge_1.msg
    vcg.hazard_lights_cmd -> ns_federate__bridge_2.msg
}
