@_fed_config()
main reactor  {

    bridge = new bridge_interface()
    
    
    
    
    
    
    nr_federate__bridge = new NetworkReceiver_1()
    nr_federate__bridge_0 = new NetworkReceiver_2()
    nr_federate__bridge_1 = new NetworkReceiver_3()
    nr_federate__bridge_2 = new NetworkReceiver_4()
    _bridgecontrol_cmd_in0 = new _bridgecontrol_cmd_in()
    _bridgegear_cmd_in0 = new _bridgegear_cmd_in()
    _bridgeturn_indicators_cmd_in0 = new _bridgeturn_indicators_cmd_in()
    _bridgehazard_lights_cmd_in0 = new _bridgehazard_lights_cmd_in()
    _bridgecontrol_cmd_in0.port -> bridge.control_cmd_in
    _bridgegear_cmd_in0.port -> bridge.gear_cmd_in
    _bridgeturn_indicators_cmd_in0.port -> bridge.turn_indicators_cmd_in
    _bridgehazard_lights_cmd_in0.port -> bridge.hazard_lights_cmd_in
    nr_federate__bridge.msg -> _bridgecontrol_cmd_in0.port0
    nr_federate__bridge_0.msg -> _bridgegear_cmd_in0.port0
    nr_federate__bridge_1.msg -> _bridgeturn_indicators_cmd_in0.port0
    nr_federate__bridge_2.msg -> _bridgehazard_lights_cmd_in0.port0
}
