target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "detection_by_tracker_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor detection_by_tracker {
    input tracked_objects_in:std::shared_ptr<autoware_perception_msgs::msg::TrackedObjects>;
    output objects_out:std::shared_ptr<autoware_perception_msgs::msg::DetectedObjects>;
    state node:{= std::shared_ptr<autoware::detection_by_tracker::DetectionByTracker> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + DETECTION_BY_TRACKER_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        self->node = std::make_shared<autoware::detection_by_tracker::DetectionByTracker>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::detection_by_tracker::DetectionByTracker>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::detection_by_tracker::DetectionByTracker>(self->node)));
    =}

    // LF input: tracked_objects_in (forwarded via spin thread until C++ interception added)
    reaction (tracked_objects_in) {=
        // TODO: call node callback directly once C++ header is modified
        // For now, the spin thread picks up data via ROS subscription
    =}
}

main reactor {
    dbt = new detection_by_tracker();
}
