/**
 * LF reactor wrapping the Autoware Core NDTScanMatcher.
 *
 * This node has a map_update_timer_ and multiple subscription callbacks.
 * For now, it runs entirely via ROS in the spin thread (timer + subscriptions).
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/ndt_scan_matcher/ndt_scan_matcher_core.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor ndt_scan_matcher {
    input pointcloud_in:std::shared_ptr<sensor_msgs::msg::PointCloud2>;
    output pose_out:std::shared_ptr<geometry_msgs::msg::PoseWithCovarianceStamped>;
    state node:{= std::shared_ptr<autoware::ndt_scan_matcher::NDTScanMatcher> =};

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + NDT_SCAN_MATCHER_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");
        try { rclcpp::init(0, NULL); } catch (...) { }

        self->node = std::make_shared<autoware::ndt_scan_matcher::NDTScanMatcher>(nodeOptions);

        // Start spin thread (timer + subscriptions run via ROS)
        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::ndt_scan_matcher::NDTScanMatcher>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::ndt_scan_matcher::NDTScanMatcher>(self->node)));
    =}

    // LF input: pointcloud_in
    reaction (pointcloud_in) {=
        if (pointcloud_in->is_present) {
            self->node->callback_sensor_points(pointcloud_in->value);
        }
    =}
}

main reactor {
    ndt = new ndt_scan_matcher();
}
