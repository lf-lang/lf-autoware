/**
 * LF reactor wrapping the Autoware ExternalCmdSelector.
 *
 * Timer-driven: selects between internal and external command sources.
 */
target CCpp {
    cmake-include: "include/CMakeListsExtension.txt"
};

preamble {=
    #include "autoware/external_cmd_selector/external_cmd_selector_node.hpp"
    #include "utils.hpp"
    #include "constants.hpp"
=}

reactor external_cmd_selector {
    state node:autoware::external_cmd_selector::ExternalCmdSelector*;
    state node_shared_ptr:std::shared_ptr<autoware::external_cmd_selector::ExternalCmdSelector>;

    reaction (startup) {=
        std::string home = get_lf_autoware_home();
        std::string yaml_path = home + "/" + EXTERNAL_CMD_SELECTOR_PARAM;

        rclcpp::NodeOptions nodeOptions = get_node_options_from_yaml(
            yaml_path.c_str(), "/**");

        self->node = new autoware::external_cmd_selector::ExternalCmdSelector(nodeOptions);
        self->node->timer_->cancel();
        self->node_shared_ptr = std::shared_ptr<autoware::external_cmd_selector::ExternalCmdSelector>(self->node);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::external_cmd_selector::ExternalCmdSelector>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::external_cmd_selector::ExternalCmdSelector>(self->node_shared_ptr)));
    =}

    timer t(0, 100 msec);
    reaction (t) {=
        self->node->on_timer();
    =}
}

main reactor {
    ecs = new external_cmd_selector();
}
