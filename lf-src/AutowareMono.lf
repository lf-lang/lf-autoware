/**
 * Monolithic (non-federated) Autoware LF program.
 *
 * Contains Sensing + Localization + Perception + Map + Planning + Control
 * + BridgeInterface. CARLA interface runs as standard ROS node externally.
 *
 * Data between nodes flows via ROS2 polling subscribers (spin threads).
 * LF controls scheduling of all timer callbacks.
 */
target CCpp {
    cmake-include: "mono-include/CMakeListsExtension.txt"
};

import Sensing from "Packages/Sensing.lf";
import Localization from "Packages/Localization.lf";
import Perception from "Packages/Perception.lf";
import Map from "Packages/Map.lf";
import Planning from "Packages/Planning.lf";
import Control from "Packages/Control.lf";
import bridge_interface from "bridge_interface/bridge_interface_main.lf";

main reactor {
    sensing = new Sensing();
    localization = new Localization();
    perception = new Perception();
    map = new Map();
    planning = new Planning();
    control = new Control();
    bridge = new bridge_interface();

    // All inter-node data flows via ROS2 topics (through spin threads).
    // LF controls scheduling of timer callbacks.

    // Control -> BridgeInterface: final commands via LF ports
    control.control_cmd_out -> bridge.control_cmd_in;
    control.gear_cmd_out -> bridge.gear_cmd_in;
    control.turn_indicators_cmd_out -> bridge.turn_indicators_cmd_in;
    control.hazard_lights_cmd_out -> bridge.hazard_lights_cmd_in;
}
