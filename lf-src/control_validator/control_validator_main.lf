target CCpp;

preamble {=
    #include "autoware/control_validator/control_validator.hpp"
    #include "utils.hpp"
=}

reactor control_validator {
    state node:{= std::shared_ptr<autoware::control_validator::ControlValidator> =};

    reaction (startup) {=
        rclcpp::NodeOptions nodeOptions;
        try { rclcpp::init(0, NULL); } catch (...) { }

        self->node = std::make_shared<autoware::control_validator::ControlValidator>(nodeOptions);

        pthread_t spinner_thread;
        pthread_create(
            &spinner_thread, NULL,
            &spin_node<std::shared_ptr<autoware::control_validator::ControlValidator>>,
            static_cast<void*>(
                new std::shared_ptr<autoware::control_validator::ControlValidator>(self->node)));
    =}
}

main reactor {
    cv = new control_validator();
}
